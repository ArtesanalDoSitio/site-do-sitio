# Sanity — crie um projeto em https://www.sanity.io/manage e preencha abaixo
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# WhatsApp — numero completo com DDI+DDD, apenas digitos (ex: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMERO=5500000000000
NEXT_PUBLIC_WHATSAPP_MENSAGEM_PADRAO=Ola! Vim pelo site e gostaria de mais informacoes.

# URL publica do site (usada em metadata/sitemap)
NEXT_PUBLIC_SITE_URL=https://exemplo.com.br
